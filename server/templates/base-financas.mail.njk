<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Finanças do Leite</title>
    <style>
      @media only screen and (max-width: 520px) {
        .card {
          width: 100% !important;
        }
      }
    </style>
  </head>

  <body style="margin:0; padding:0; background-color:#f4f6f8; font-family: Arial, Helvetica, sans-serif;">
    <table width="100%" cellpadding="0" cellspacing="0" style="padding: 40px 0;">
      <tr>
        <td align="center">
          <table class="card" width="520" cellpadding="0" cellspacing="0" style="background-color:#ffffff; border-radius:8px; overflow:hidden; box-shadow: 0 2px 8px rgba(0,0,0,0.08);">

            <!-- Cabeçalho -->
            <tr>
              <td style="padding: 18px 32px; text-align:center; border-bottom:3px solid #166534;">
                <div style="font-size:20px; font-weight:bold; color:#166534;">
                  Finanças do Leite
                </div>
                <div style="font-size:13px; color:#166534; letter-spacing:0.5px; margin-top:4px;">
                  Sua fazenda funcionando no azul, mês após mês.
                </div>
              </td>
            </tr>

            <!-- Título -->
            <tr>
              <td style="text-align:center; font-size:22px; font-weight:bold; color:#1f2937; padding: 24px 32px 0 32px;">
                {% block titulo %}{% endblock %}
              </td>
            </tr>

            <!-- Corpo -->
            <tr>
              <td style="padding: 20px 32px 24px 32px;">
                {% block content %}{% endblock %}
              </td>
            </tr>

            <!-- Rodapé -->
            <tr>
              <td style="padding: 0 32px 32px 32px;">
                <hr style="border:none; border-top:1px solid #e5e7eb; margin:0 0 16px 0;" />
                <p style="font-size:12px; color:#6b7280; line-height:1.6; margin:0;">
                  Este é um e-mail automático do Finanças do Leite. Por favor, não responda a esta mensagem.
                </p>
              </td>
            </tr>

          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
