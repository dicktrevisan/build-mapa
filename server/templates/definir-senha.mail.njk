{% extends "base-financas.mail.njk" %}

{% block titulo %}Sua conta foi criada{% endblock %}

{% block content %}
  <p style="font-size:14px; color:#374151; margin:0 0 12px 0;">
    Olá, {{ nome }},
  </p>

  <p style="font-size:14px; color:#4b5563; line-height:1.6; margin:0 0 16px 0;">
    <strong>{{ criadoPor }}</strong> criou a sua conta no Finanças do Leite.
  </p>

  <p style="font-size:14px; color:#4b5563; line-height:1.6; margin:0 0 24px 0;">
    Clique no botão abaixo para definir a sua senha e acessar o aplicativo.
  </p>

  <!-- Link para definir a senha -->
  <table width="100%" cellpadding="0" cellspacing="0" style="margin: 0 0 24px 0;">
    <tr>
      <td align="center">
        <a href="{{ link }}" style="display:inline-block; background-color:#166534; color:#ffffff; font-size:15px; font-weight:bold; text-decoration:none; padding:12px 28px; border-radius:6px;">
          Definir senha
        </a>
      </td>
    </tr>
  </table>

  <p style="font-size:12px; color:#6b7280; line-height:1.6; margin:0 0 8px 0;">
    Se o botão não funcionar, copie e cole este endereço no navegador:<br/>
    <span style="word-break:break-all; color:#166534;">{{ link }}</span>
  </p>

  <table width="100%" cellpadding="0" cellspacing="0" style="margin: 16px 0 0 0;">
    <tr>
      <td style="background-color:#fef3c7; border-left:4px solid #f59e0b; border-radius:4px; padding:12px 16px;">
        <p style="font-size:13px; color:#92400e; margin:0; line-height:1.6;">
          O link vale até <strong>{{ validade }}</strong>. Se você não esperava este e-mail, basta ignorá-lo.
        </p>
      </td>
    </tr>
  </table>
{% endblock %}
