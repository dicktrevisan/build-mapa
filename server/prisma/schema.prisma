generator client {
  provider = "prisma-client"
  output   = "../src/generated/client"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  nome            String
  email           String    @unique
  password        String
  senhaProvisoria String?
  documento       String
  endereco        Endereco?
  telefone        String
  emailSecundario String?
  // LEGADO: vinculo unico de antes; o startup migra para UsuarioFazenda e limpa. Remover depois.
  fazenda         Fazenda?  @relation("FuncionariosFazenda", fields: [fazendaId], references: [id])
  // Fazendas em que o usuario e operador (ser administrador vem de Fazenda.administradorId)
  vinculos        UsuarioFazenda[]
  // Fazendas em que o usuario e o administrador
  fazendasAdministradas Fazenda[] @relation("AdministradorFazenda")
  role            Role
  ativo           Boolean   @default(false)
  validado        Boolean   @default(false)
  bloqueado       Boolean   @default(false)
  lancamentos     Lancamento[]
  planoPessoal PlanoPessoal @default(CONVIDADO)
  // Plano contratado pelo usuario: vale para as fazendas que ele administra
  // (a fazenda nao tem plano; validade e modulos dela sao os do administrador)
  plano        Planos       @default(OPERADOR)
  validade     DateTime?
  modulos      Modulos[]
  pagamentos   Pagamento[]
  // Convites para operadores que este usuario enviou como administrador da fazenda
  convitesEnviados Convite[] @relation("ConvitesEnviados")
  // Lado virtual da relacao 1-1 (o Prisma exige); nada e gravado no usuario
  organizadorPessoal OrganizadorPessoal?

  lastLogin DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  fazendaId String?  @db.ObjectId
}

model Fazenda {
  id           String      @id @default(auto()) @map("_id") @db.ObjectId
  nome         String
  razaoSocial  String
  cnpj         String?
  // LEGADO: usuarios do vinculo unico de antes (ver User.fazenda). Remover depois.
  funcionarios User[]      @relation("FuncionariosFazenda")
  // Operadores da fazenda; o administrador nao tem vinculo (e o administradorId)
  vinculos     UsuarioFazenda[]
  // Administrador da fazenda: toda fazenda criada tem um (opcional so para as ja existentes)
  // NoAction quebra o ciclo User.fazenda -> Fazenda.administrador (o app nao apaga usuarios nem troca ids)
  administrador   User?    @relation("AdministradorFazenda", fields: [administradorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  administradorId String?  @db.ObjectId
  endereco     String
  area         Float
  idioma       Idiomas     @relation(fields: [idiomasId], references: [id])
  idiomasId    String      @db.ObjectId
  agrupamentos Agrupamento[]

  // Dados da propriedade (base: properties)
  proprietario String?
  unidadesMo   Float       @default(0)
  aliquotaIr   Float       @default(0)
  fotoPath     String?

  bancos               Banco[]
  titulares            Titular[]
  lancamentos          Lancamento[]
  orcamentos           Orcamento[]
  zeragens             Zeragem[]
  registrosMensais     RegistroMensal[]
  imobilizados         Imobilizado[]
  balancosPatrimoniais BalancoPatrimonial[]
  convites             Convite[]

  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model Pagamento {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  // O pagamento e do usuario (o plano e dele)
  usuario   User?    @relation(fields: [usuarioId], references: [id])
  usuarioId String?  @db.ObjectId
  dataPagamento DateTime @default(now())
  validade DateTime
  cpfPagador String
  valor Float
  
}

type Endereco {
  cep         String
  rua         String
  numero      String
  bairro      String
  cidade      String
  estado      String
  pais        String
  coordenadas String
}

enum Modulos {
  CADASTROS
  FLUXO_CAIXA
  GERENCIAL
  CONTABIL
  ANALISE
  RELATORIOS
  ORCAMENTO
  IMOBILIZADO
  STORAGE
  PESSOAL
}

// Plano do usuario: OPERADOR e o de quem entra por convite; quem paga um plano passa a ter o plano pago
enum Planos {
  OPERADOR
  STARTER
  PLUS
  PRO
  MASTER
}
enum PlanoPessoal {
  CONVIDADO
  STARTER
  PLUS
  PRO
  MASTER
}
model Idiomas {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  referencia String
  codigo     String
  translate  String
  fazendas   Fazenda[]
}

// Agrupamento de categorias (ex.: Nutricao); a classificacao gerencial (tipo) fica aqui
// e e o que o Consolidado e a Analise usam
model Agrupamento {
  id         String      @id @default(auto()) @map("_id") @db.ObjectId
  nome       String
  descricao  String
  icone      String
  cor        String
  tipo       TipoFluxo
  categorias Categoria[]
  fazenda    Fazenda?    @relation(fields: [fazendaId], references: [id])
  fazendaId  String?     @db.ObjectId
}

// Categoria do lancamento (ex.: Concentrados), sempre dentro de um agrupamento
model Categoria {
  id            String       @id @default(auto()) @map("_id") @db.ObjectId
  nome          String
  descricao     String
  icone         String
  cor           String
  agrupamento   Agrupamento  @relation(fields: [agrupamentoId], references: [id])
  agrupamentoId String       @db.ObjectId
  lancamentos   Lancamento[]
}

model Banco {
  id          String       @id @default(auto()) @map("_id") @db.ObjectId
  nome        String
  fazenda     Fazenda      @relation(fields: [fazendaId], references: [id])
  fazendaId   String       @db.ObjectId
  lancamentos Lancamento[]
  createdAt   DateTime     @default(now())

  @@unique([fazendaId, nome])
}

model Titular {
  id          String       @id @default(auto()) @map("_id") @db.ObjectId
  nome        String
  fazenda     Fazenda      @relation(fields: [fazendaId], references: [id])
  fazendaId   String       @db.ObjectId
  lancamentos Lancamento[]
  createdAt   DateTime     @default(now())

  @@unique([fazendaId, nome])
}

model Lancamento {
  id              String             @id @default(auto()) @map("_id") @db.ObjectId
  descricao       String
  valor           Float
  // Tipo fixo do lancamento (entrada ou saida do caixa)
  tipo            TipoLancamento
  // Lancamento e vencimento sao gerenciais; o pagamento e o que conta no caixa e no consolidado
  data            DateTime
  dataVencimento  DateTime
  dataPagamento   DateTime?
  mesesUtilizacao Int                @default(1)
  situacao        SituacaoLancamento @default(FINALIZADO)
  semNotaFiscal   Boolean            @default(false)
  notaFiscalNome  String?
  notaFiscalPath  String?
  parcelaGrupoId  String?
  parcelaNum      Int?
  parcelaTotal    Int?

  fazenda        Fazenda      @relation(fields: [fazendaId], references: [id])
  fazendaId      String       @db.ObjectId
  categoria      Categoria    @relation(fields: [categoriaId], references: [id])
  categoriaId    String       @db.ObjectId
  banco          Banco?       @relation(fields: [bancoId], references: [id])
  bancoId        String?      @db.ObjectId
  titular        Titular?     @relation(fields: [titularId], references: [id])
  titularId      String?      @db.ObjectId
  operador       User?        @relation(fields: [operadorId], references: [id])
  operadorId     String?      @db.ObjectId

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Orcamento {
  id            String  @id @default(auto()) @map("_id") @db.ObjectId
  ano           Int
  mes           Int
  // Estimativas do mes (digitadas): valorPrevisto e a despesa prevista
  valorPrevisto Float   @default(0)
  // Opcional porque os orcamentos antigos nao tem o campo gravado
  receitaPrevista Float?
  observacao    String?
  fazenda       Fazenda @relation(fields: [fazendaId], references: [id])
  fazendaId     String  @db.ObjectId

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([fazendaId, ano, mes])
}

model Zeragem {
  id           String  @id @default(auto()) @map("_id") @db.ObjectId
  ano          Int
  mes          Int
  modo         ModoZeragem
  valorOrigem  Float   @default(0)
  valorAlocado Float   @default(0)
  contaAtivo   String?
  observacao   String?
  fazenda      Fazenda @relation(fields: [fazendaId], references: [id])
  fazendaId    String  @db.ObjectId

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([fazendaId, ano, mes])
}

// --- Fluxo gerencial (base: monthly_records, imobilizado) ---

model RegistroMensal {
  id               String  @id @default(auto()) @map("_id") @db.ObjectId
  ano              Int
  mes              Int
  litrosProduzidos Float   @default(0)
  precoLeiteLitro  Float   @default(0)
  vacasLactacao    Int     @default(0)
  vacasSecas       Int     @default(0)
  recria           Int     @default(0)
  observacoes      String?
  fazenda          Fazenda @relation(fields: [fazendaId], references: [id])
  fazendaId        String  @db.ObjectId

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([fazendaId, ano, mes])
}

model Imobilizado {
  id                    String               @id @default(auto()) @map("_id") @db.ObjectId
  ano                   Int
  mes                   Int
  categoria             CategoriaImobilizado
  descricao             String               @default("")
  valor                 Float                @default(0)
  valorNovo             Float?
  valorSucata           Float?
  vidaUtil              Float?
  tempoUso              Float?
  taxaJurosAa           Float?
  usarCustoOportunidade Boolean              @default(true)
  fazenda               Fazenda              @relation(fields: [fazendaId], references: [id])
  fazendaId             String               @db.ObjectId

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// --- Fluxo contabil (base: balanco_patrimonial) ---

model BalancoPatrimonial {
  id        String       @id @default(auto()) @map("_id") @db.ObjectId
  ano       Int
  mes       Int
  secao     SecaoBalanco
  conta     String
  valor     Float        @default(0)
  fazenda   Fazenda      @relation(fields: [fazendaId], references: [id])
  fazendaId String       @db.ObjectId

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum TipoFluxo {
  RECEITAS
  DESEMBOLSO
  FIXO
  VARIAVEL
  DESPESA_FINANCEIRA
  INVESTIMENTO
  NAO_OPERACIONAL
}

// Tipos fixos do lancamento; os externos ainda serao categorizados
enum TipoLancamento {
  RECEITAS
  DESPESAS
  RECEITAS_EXTERNAS
  DESPESAS_EXTERNAS
}

// ABERTO = pendente (sem pagamento); FINALIZADO = efetivado (com data de pagamento)
enum SituacaoLancamento {
  ABERTO
  FINALIZADO
}

// TOTAL_ATIVO move todo o saldo para uma conta do Ativo Circulante,
// PARCIAL_ATIVO move parte, ZERAR apenas zera o saldo
enum ModoZeragem {
  TOTAL_ATIVO
  PARCIAL_ATIVO
  ZERAR
}

enum CategoriaImobilizado {
  REBANHO
  EQUIPAMENTOS
  MAQUINAS
  TERRA
  INSTALACOES
  CASAS
}

// AC ativo circulante, AI ativo intermediario, AL ativo longo prazo,
// PC passivo circulante, PI passivo intermediario, PLP passivo longo prazo,
// PL patrimonio liquido
enum SecaoBalanco {
  AC
  AI
  AL
  PC
  PI
  PL
  PLP
}

// Usuario como operador de uma fazenda: um usuario pode ser operador de varias
// fazendas e administrador de outras (Fazenda.administradorId)
model UsuarioFazenda {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  usuario   User     @relation(fields: [usuarioId], references: [id])
  usuarioId String   @db.ObjectId
  fazenda   Fazenda  @relation(fields: [fazendaId], references: [id])
  fazendaId String   @db.ObjectId
  createdAt DateTime @default(now())

  @@unique([usuarioId, fazendaId])
}

// PREMIUM: tem plano e pode administrar fazendas (o admin de cada fazenda e o Fazenda.administradorId)
// GERENTE: parametros da aplicacao e cria usuarios admin (plano e validade); tambem pode administrar fazendas
// MASTER: tudo do GERENTE, mais as variaveis do servidor e tornar usuarios GERENTE
enum Role {
  PREMIUM
  USER
  GERENTE
  MASTER
}

// Convite do administrador da fazenda para um operador (role USER), pelo e-mail.
// O link de ativacao e um JWT (e-mail + fazenda); este registro permite listar,
// cancelar e usar o convite uma vez so (o aceite exige um convite PENDENTE).
// NoAction nas relacoes evita ciclos (Convite -> User -> Fazenda e Convite -> Fazenda)
model Convite {
  id             String        @id @default(auto()) @map("_id") @db.ObjectId
  email          String
  status         StatusConvite @default(PENDENTE)
  validade       DateTime
  aceitoEm       DateTime?
  excluidoEm     DateTime?
  fazenda        Fazenda       @relation(fields: [fazendaId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  fazendaId      String        @db.ObjectId
  convidadoPor   User          @relation("ConvitesEnviados", fields: [convidadoPorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  convidadoPorId String        @db.ObjectId

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Convite cancelado antes do aceite e apagado; EXCLUIDO = operador removido da fazenda depois do aceite
enum StatusConvite {
  PENDENTE
  ACEITO
  EXCLUIDO
}

enum AuthType {
  CHECK
  AUTH
  NONE
}

// --- Financas pessoais (modulo separado: nada da fazenda) ---

// Dados do organizador pessoal: opcional, criado no primeiro acesso de quem tem plano pessoal
model OrganizadorPessoal {
  id          String              @id @default(auto()) @map("_id") @db.ObjectId
  usuario     User                @relation(fields: [usuarioId], references: [id])
  usuarioId   String              @unique @db.ObjectId
  contas      ContaPessoal[]
  categorias  CategoriaPessoal[]
  lancamentos LancamentoPessoal[]
  orcamentos  OrcamentoPessoal[]
  metas       MetaPessoal[]
  createdAt   DateTime            @default(now())
}

model ContaPessoal {
  id            String              @id @default(auto()) @map("_id") @db.ObjectId
  nome          String
  tipo          TipoContaPessoal
  saldoInicial  Float               @default(0)
  organizador   OrganizadorPessoal  @relation(fields: [organizadorId], references: [id])
  organizadorId String              @db.ObjectId
  lancamentos   LancamentoPessoal[]
  createdAt     DateTime            @default(now())

  @@unique([organizadorId, nome])
}

model CategoriaPessoal {
  id            String                @id @default(auto()) @map("_id") @db.ObjectId
  nome          String
  tipo          TipoLancamentoPessoal
  organizador   OrganizadorPessoal    @relation(fields: [organizadorId], references: [id])
  organizadorId String                @db.ObjectId
  lancamentos   LancamentoPessoal[]
  orcamentos    OrcamentoPessoal[]
  createdAt     DateTime              @default(now())

  @@unique([organizadorId, nome, tipo])
}

model LancamentoPessoal {
  id            String                @id @default(auto()) @map("_id") @db.ObjectId
  descricao     String
  valor         Float
  data          DateTime
  tipo          TipoLancamentoPessoal
  situacao      SituacaoLancamento    @default(FINALIZADO)
  observacao    String?
  categoria     CategoriaPessoal      @relation(fields: [categoriaId], references: [id])
  categoriaId   String                @db.ObjectId
  conta         ContaPessoal          @relation(fields: [contaId], references: [id])
  contaId       String                @db.ObjectId
  organizador   OrganizadorPessoal    @relation(fields: [organizadorId], references: [id])
  organizadorId String                @db.ObjectId

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OrcamentoPessoal {
  id            String             @id @default(auto()) @map("_id") @db.ObjectId
  ano           Int
  mes           Int
  valorPrevisto Float              @default(0)
  categoria     CategoriaPessoal   @relation(fields: [categoriaId], references: [id])
  categoriaId   String             @db.ObjectId
  organizador   OrganizadorPessoal @relation(fields: [organizadorId], references: [id])
  organizadorId String             @db.ObjectId

  @@unique([organizadorId, categoriaId, ano, mes])
}

model MetaPessoal {
  id            String             @id @default(auto()) @map("_id") @db.ObjectId
  nome          String
  valorAlvo     Float
  valorAtual    Float              @default(0)
  prazo         DateTime?
  organizador   OrganizadorPessoal @relation(fields: [organizadorId], references: [id])
  organizadorId String             @db.ObjectId
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
}

enum TipoContaPessoal {
  CORRENTE
  POUPANCA
  CARTEIRA
  CARTAO_CREDITO
  INVESTIMENTO
}

enum TipoLancamentoPessoal {
  RECEITA
  DESPESA
}

// Parametros variaveis da aplicacao. GERAL e INDICADOR: GERENTE e MASTER alteram; SERVIDOR: so o MASTER.
// GERAL e SERVIDOR usam `valor`; INDICADOR usa as faixas de cor da Analise financeira (bom = azul, aviso = amarelo,
// perigo = vermelho), conforme o sentido (maior ou menor e melhor)
model Parametro {
  id        String            @id @default(auto()) @map("_id") @db.ObjectId
  chave     String            @unique
  nome      String
  descricao String?
  grupo     GrupoParametro
  ordem     Int               @default(0)
  // percentual (guardado em fracao: 0.4 = 40%), moeda ou numero
  formato   String            @default("numero")
  valor     Float?
  sentido   SentidoIndicador?
  bom       Float?
  aviso     Float?
  perigo    Float?
  updatedAt DateTime          @updatedAt
}

enum GrupoParametro {
  GERAL
  INDICADOR
  SERVIDOR
}

enum SentidoIndicador {
  MAIOR_MELHOR
  MENOR_MELHOR
}
