generator client {
  provider = "prisma-client"
  output   = "../src/generated/client"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}



model User {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  nome            String
  email           String @unique
  password           String
  senhaProvisoria String?
  documento       String
  endereco        Endereco?
  telefone        String
  emailSecundario String?
  fazenda         Fazenda?  @relation(fields: [fazendaId], references: [id])
  role            Role
  ativo           Boolean  @default(false)
  validado        Boolean  @default(false)
  bloqueado        Boolean  @default(false)

  lastLogin DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  fazendaId String?   @db.ObjectId
}

model Fazenda {
  id           String      @id @default(auto()) @map("_id") @db.ObjectId
  nome         String
  razaoSocial  String
  cnpj         String?
  funcionarios User[]
  endereco     String
  modulos      Modulos[]
  area         Float
  plano        Planos
  idioma       Idiomas     @relation(fields: [idiomasId], references: [id])
  idiomasId String   @db.ObjectId
  categorias   Categoria[]

  validade DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

type Endereco {
  cep         String
  rua         String
  numero      String
  bairro      String
  cidade      String
  estado      String
  pais        String
  coordenadas String
}

enum Modulos {
  CADASTROS
  FLUXO_CAIXA
  GERENCIAL
  CONTABIL
  ANALISE
  RELATORIOS
  ORCAMENTO
  IMOBILIZADO
  STORAGE
}

enum Planos {
  STARTER
  PLUS
  PRO
  MASTER
}

model Idiomas {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  referencia String
  codigo     String
  translate  String
  fazendas   Fazenda[]
}

model Categoria {
  id            String         @id @default(auto()) @map("_id") @db.ObjectId
  nome          String
  descricao     String
  icone         String
  cor           String
  subCategorias SubCategoria[]
  fazenda       Fazenda?       @relation(fields: [fazendaId], references: [id])
  fazendaId     String?        @db.ObjectId
}

model SubCategoria {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  nome        String
  descricao   String
  icone       String
  cor         String
  categoria   Categoria @relation(fields: [categoriaId], references: [id])
  categoriaId String    @db.ObjectId
}

enum Role {
  ADMIN
  USER
}


enum AuthType {
  CHECK
  AUTH
  NONE
  
}